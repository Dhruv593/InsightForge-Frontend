VITE_API_BASE_URL=http://localhost:8000/api/v1
# Production example: https://your-api.up.railway.app/api/v1

# Public frontend origin used for canonical URLs and generated sitemap/robots files.
# Vercel supplies its production hostname automatically, but an explicit custom domain is preferred.
VITE_SITE_URL=http://localhost:5173

# Set true after configuring GOOGLE_CLIENT_ID in the server .env.
# For Google sign-in use http://localhost:8000/api/v1 above when frontend is localhost.
# The client ID is fetched from the server; never put a client secret in VITE_*.
VITE_GOOGLE_SIGN_IN_ENABLED=false
